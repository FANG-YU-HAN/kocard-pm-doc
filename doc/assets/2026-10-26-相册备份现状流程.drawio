        <mxCell id="trigger" value="触发：选择备份硬盘 / 自动同步开启 / 硬盘重新接入&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#D6DEE4&#x27;&gt;两端入口不同，分别进入 startBackup()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3E4A54;strokeColor=#3E4A54;strokeWidth=1;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="108" width="1080" height="58" as="geometry" /></mxCell>

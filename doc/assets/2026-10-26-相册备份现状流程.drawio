        <mxCell id="btitle" value="读图结论（按当前实现）" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="40" y="1418" width="800" height="26" as="geometry" /></mxCell>
        <mxCell id="b1" value="① 两端都只做了“拷出去”&lt;br&gt;没有还原链路" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF7F4;strokeColor=#B0897F;strokeWidth=1;fontColor=#5A3A2E;fontSize=11;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="1454" width="540" height="96" as="geometry" /></mxCell>
        <mxCell id="b2" value="② iOS 少拿一个文件&lt;br&gt;只写第一个 .photo / .video&lt;br&gt;.pairedVideo 被跳过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF7F4;strokeColor=#B0897F;strokeWidth=1;fontColor=#5A3A2E;fontSize=11;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="600" y="1454" width="540" height="96" as="geometry" /></mxCell>
        <mxCell id="b3" value="③ Android 靠字节保留动态&lt;br&gt;单文件机型完整&lt;br&gt;vivo 这类双文件关系没有记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF7F4;strokeColor=#B0897F;strokeWidth=1;fontColor=#5A3A2E;fontSize=11;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1160" y="1454" width="560" height="96" as="geometry" /></mxCell>
        <mxCell id="footer" value="平台约束：iOS 后台任务只争取有限时间；Android 未使用前台服务，退到后台可能被系统暂停。" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#6B7780;" vertex="1" parent="1"><mxGeometry x="40" y="1564" width="1680" height="20" as="geometry" /></mxCell>

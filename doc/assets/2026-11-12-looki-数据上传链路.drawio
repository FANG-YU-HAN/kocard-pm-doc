<mxfile host="Electron" agent="Qoder">
  <diagram id="2026-11-12-looki-数据上传链路" name="LOOKI L1 · 数据从拍摄到云端">
    <mxGraphModel dx="2583" dy="1327" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" vertex="1" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F2933;" value="LOOKI L1 · 数据从拍摄到云端">
          <mxGeometry x="40" y="16" width="900" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" vertex="1" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#8A97A3;" value="来源：Looki 官方数据隐私说明（2026-08）、创始人孙洋访谈、雷科技 CES 2026 实测 ｜ 标注「推断」的为我的判断，官方未明说">
          <mxGeometry x="40" y="52" width="1120" height="18" as="geometry" />
        </mxCell>
        <mxCell id="sep0" parent="1" vertex="1" style="line;html=1;strokeColor=#DCE2E7;strokeWidth=1;" value="">
          <mxGeometry x="40" y="82" width="1120" height="1" as="geometry" />
        </mxCell>

        <mxCell id="s1" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93A1AC;strokeWidth=1;fontColor=#2A3540;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;" value="&lt;b&gt;① 采集&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7885&quot;&gt;照片 · 短视频 · 音频 · 时间戳。设备本身没有 GPS，位置由配对手机补，需给 App 定位权限；App 关闭后不再收集位置。&lt;/font&gt;">
          <mxGeometry x="40" y="100" width="600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93A1AC;strokeWidth=1;fontColor=#2A3540;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;" value="&lt;b&gt;② 本地存储 · 32GB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7885&quot;&gt;默认不上云。不上传就一直留在设备里，直到你删除、重置设备，或写满后被循环录制规则覆盖。&lt;/font&gt;">
          <mxGeometry x="40" y="194" width="600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93A1AC;strokeWidth=1;fontColor=#2A3540;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;" value="&lt;b&gt;③ 敏感场景过滤 · 端侧（推断）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7885&quot;&gt;识别敏感环境，直接拦下不上传。官方定性：这只是一层保护，不替代告知他人、取得同意、避开敏感场所。&lt;/font&gt;">
          <mxGeometry x="40" y="288" width="600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7ECF0;strokeColor=#5B6770;strokeWidth=1;fontColor=#2A3540;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;" value="&lt;b&gt;④ 授权门 · 两条触发路径&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7885&quot;&gt;手动同步；或打开某个需要云端的功能开关 —— &lt;b&gt;开关一次即批准该功能之后全部上传，不再逐次确认&lt;/b&gt;。授权粒度是功能级，不是传输级。&lt;/font&gt;">
          <mxGeometry x="40" y="382" width="600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93A1AC;strokeWidth=1;fontColor=#2A3540;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;" value="&lt;b&gt;⑤ 上传&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7885&quot;&gt;设备自己连 Wi-Fi 传字节；走手机流量则每次上传限文件大小。推断：App 只做控制面（授权与调度），不承载数据面 —— 这也解释了家里 Wi-Fi 需浏览器登录时上传必失败。&lt;/font&gt;">
          <mxGeometry x="40" y="476" width="600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93A1AC;strokeWidth=1;fontColor=#2A3540;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;" value="&lt;b&gt;⑥ Looki 云端加密存储&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7885&quot;&gt;传输中与静态存储均加密，访问严格受限。用到云端 AI 功能时，Looki 与授权供应商按需临时解密所需内容。&lt;/font&gt;">
          <mxGeometry x="40" y="570" width="600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s7" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93A1AC;strokeWidth=1;fontColor=#2A3540;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;" value="&lt;b&gt;⑦ AI 供应商临时处理&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7885&quot;&gt;OpenAI 与 Google（含 Gemini）。按功能最小必要分发，不是每个请求都发给每家。已开 zero-training + zero-retention，不允许用你的内容训练通用模型。&lt;/font&gt;">
          <mxGeometry x="40" y="664" width="600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s8" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93A1AC;strokeWidth=1;fontColor=#2A3540;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;" value="&lt;b&gt;⑧ AI 生成物写回账号&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7885&quot;&gt;Moments · Memories · Journal · 每日 Vlog · 宫格漫画 · 摘要。&lt;/font&gt;">
          <mxGeometry x="40" y="758" width="600" height="76" as="geometry" />
        </mxCell>

        <mxCell id="e1" parent="1" source="s1" target="s2" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#93A1AC;strokeWidth=1;endArrow=block;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">

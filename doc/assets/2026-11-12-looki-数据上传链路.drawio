        <mxCell id="e4" parent="1" source="s4" target="s5" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5B6770;strokeWidth=1;endArrow=block;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#5B6770;" value="放行">
          <mxGeometry relative="1" as="geometry" />

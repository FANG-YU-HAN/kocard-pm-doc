          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" parent="1" source="s7" target="s8" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#93A1AC;strokeWidth=1;endArrow=block;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rcap1" parent="1" vertex="1" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#5B6770;" value="四类数据，四条删除时间线（官方明确说没有统一计时器）">
          <mxGeometry x="680" y="100" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r1" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#DCE2E7;strokeWidth=1;fontColor=#2A3540;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;设备本地副本&lt;/b&gt; → 上传完成后 &lt;b&gt;12 小时&lt;/b&gt;计划删除">
          <mxGeometry x="680" y="128" width="480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r2" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#DCE2E7;strokeWidth=1;fontColor=#2A3540;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;发给供应商的原始媒体&lt;/b&gt; → 走供应商零留存设置，处理完即弃">
          <mxGeometry x="680" y="186" width="480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r3" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#DCE2E7;strokeWidth=1;fontColor=#2A3540;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;你保存/同步到账号的素材&lt;/b&gt; → 留到你删除或注销账号">
          <mxGeometry x="680" y="244" width="480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r4" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#DCE2E7;strokeWidth=1;fontColor=#2A3540;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;AI 生成物&lt;/b&gt; → 留到你删除或注销账号">
          <mxGeometry x="680" y="302" width="480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rnote" parent="1" vertex="1" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#8A97A3;whiteSpace=wrap;" value="删原始素材、删生成的 Memory、注销账号是三个不同的动作，App 里分开操作。">
          <mxGeometry x="680" y="360" width="480" height="30" as="geometry" />
        </mxCell>

        <mxCell id="rcap2" parent="1" vertex="1" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#5B6770;" value="合规进度">
          <mxGeometry x="680" y="404" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r5" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#DCE2E7;strokeWidth=1;fontColor=#2A3540;fontSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" value="已过：SOC 2 Type I（只审某一时点的控制设计）&lt;br&gt;在途：SOC 2 Type II · ISO 27001/27701 · GDPR 对齐 · CCPA/CPRA · HIPAA 场景评估 · EN 18031/RED">
          <mxGeometry x="680" y="432" width="480" height="64" as="geometry" />
        </mxCell>

        <mxCell id="rcap3" parent="1" vertex="1" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#5B6770;" value="三处要打问号">
          <mxGeometry x="680" y="516" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r6" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93A1AC;strokeWidth=1;dashed=1;fontColor=#2A3540;fontSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" value="· 云存储用 AWS、数据存用户所在区域、本地最多存 5 天 —— 只有媒体转述，官方那篇没写。&lt;br&gt;· 端侧跑 Loom 筛选模型 —— 由「过滤必须在上传前生效」和「故事模式每 3 分钟录 15 秒」推出，官方未明说部署位置。&lt;br&gt;· 网传「云端只保留一天」是误传，混淆了设备副本 12 小时删除与供应商零留存两件事。">
          <mxGeometry x="680" y="544" width="480" height="76" as="geometry" />
        </mxCell>

        <mxCell id="rcap4" parent="1" vertex="1" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#5B6770;" value="对 kocard 的两条直接启发">
          <mxGeometry x="680" y="644" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r7" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#DCE2E7;strokeWidth=1;fontColor=#2A3540;fontSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" value="&lt;b&gt;授权粒度&lt;/b&gt;：Looki 选功能级一次授权、长期生效，用「默认不上云 + 设备能随时摘下」换掌控感，而不是逐次弹窗。你的自动备份是同一道题。&lt;br&gt;&lt;br&gt;&lt;b&gt;上传不能绑死 Wi-Fi&lt;/b&gt;：Looki 这条被实测列为主要痛点，而拍摄现场往往根本没网。离线队列 + 断点续传 + 回网自动补传，且要让用户看得见「还有多少没传」。">
          <mxGeometry x="680" y="672" width="480" height="92" as="geometry" />
        </mxCell>

      </root>

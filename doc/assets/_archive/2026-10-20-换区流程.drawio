<mxfile host="app.diagrams.net" modified="2026-10-20T00:00:00.000Z" agent="Qoder" version="32.5.5" type="device">
  <diagram id="2026-10-20-换区流程" name="KOCARD · 换区路径：登录前切换服务器 / 登录后切换区域（目标态）">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1280" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="KOCARD · 换区路径：登录前切换服务器 / 登录后切换区域（目标态）" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#2E2E2B;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1500" height="36" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="v0.1 · 2026-10-20 · 换区不是搬家，是切换所连接的服务区；账号、订阅、订单、AI 余额按区域独立" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#7C766B;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1540" height="24" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;span style='color:#B8AE9E'&gt;■&lt;/span&gt; 用户 &amp;nbsp; &lt;span style='color:#A8A8A2'&gt;■&lt;/span&gt; 客户端 &amp;nbsp; &lt;span style='color:#9CA69B'&gt;■&lt;/span&gt; 账号服务 &amp;nbsp; &lt;span style='color:#8E9C88'&gt;■&lt;/span&gt; 成功 &amp;nbsp; &lt;span style='color:#B49A92'&gt;■&lt;/span&gt; 阻断" style="text;html=1;fontSize=10;align=right;verticalAlign=middle;fontColor=#5F5A52;" vertex="1" parent="1"><mxGeometry x="1080" y="16" width="880" height="36" as="geometry"/></mxCell>
        <mxCell id="principle" value="原则：换区不是搬家，是切换所连接的服务区。账号、订阅、订单、AI 余额、任务数据都按区域独立；不做权益搬运。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F3EA;strokeColor=#C9B99A;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#5C5140;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1920" height="40" as="geometry"/></mxCell>
        <mxCell id="panelA" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF9F5;strokeColor=#D9D3C8;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="900" height="720" as="geometry"/></mxCell>
        <mxCell id="panelAtitle" value="A. 登录前：切换服务器（无账号变更）" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;fontColor=#3B3731;" vertex="1" parent="1"><mxGeometry x="60" y="165" width="860" height="30" as="geometry"/></mxCell>
        <mxCell id="panelB" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF9F5;strokeColor=#D9D3C8;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="980" y="150" width="980" height="720" as="geometry"/></mxCell>
        <mxCell id="panelBtitle" value="B. 登录后：切换账号区域（有资产约束）" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;fontColor=#3B3731;" vertex="1" parent="1"><mxGeometry x="1000" y="165" width="940" height="30" as="geometry"/></mxCell>
        <mxCell id="A1" value="登录页点击「切换服务器」" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.2;fontColor=#3A3A36;fillColor=#F4F1EB;strokeColor=#B8AE9E;" vertex="1" parent="1"><mxGeometry x="100" y="215" width="320" height="58" as="geometry"/></mxCell>
        <mxCell id="A2" value="选择中国内地 / 国际" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.2;fontColor=#3A3A36;fillColor=#F4F1EB;strokeColor=#B8AE9E;" vertex="1" parent="1"><mxGeometry x="100" y="300" width="320" height="58" as="geometry"/></mxCell>
        <mxCell id="A3" value="提示：只影响本次登录&lt;br&gt;不转移账号 / 订阅" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.2;fontColor=#3A3A36;fillColor=#F7F7F5;strokeColor=#A8A8A2;" vertex="1" parent="1"><mxGeometry x="100" y="385" width="320" height="58" as="geometry"/></mxCell>
        <mxCell id="A4" value="切换 base URL&lt;br&gt;清缓存、重载区域配置" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.2;fontColor=#3A3A36;fillColor=#F7F7F5;strokeColor=#A8A8A2;" vertex="1" parent="1"><mxGeometry x="100" y="470" width="320" height="58" as="geometry"/></mxCell>
        <mxCell id="A5" value="目标区登录 / 注册" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.2;fontColor=#3A3A36;fillColor=#F4F1EB;strokeColor=#B8AE9E;" vertex="1" parent="1"><mxGeometry x="100" y="555" width="320" height="58" as="geometry"/></mxCell>
        <mxCell id="A6" value="进入目标区服务" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.2;fontColor=#3A3A36;fillColor=#EDF1EB;strokeColor=#8E9C88;fontStyle=1;fontColor=#3E4A3B;" vertex="1" parent="1"><mxGeometry x="100" y="640" width="320" height="58" as="geometry"/></mxCell>
        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;fontSize=10;labelBackgroundColor=#FCFCFA;fontColor=#4A4A45;strokeColor=#8C8C86;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="A1" target="A2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;fontSize=10;labelBackgroundColor=#FCFCFA;fontColor=#4A4A45;strokeColor=#8C8C86;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="A2" target="A3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" value="确认" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;fontSize=10;labelBackgroundColor=#FCFCFA;fontColor=#4A4A45;strokeColor=#8C8C86;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="A3" target="A4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;fontSize=10;labelBackgroundColor=#FCFCFA;fontColor=#4A4A45;strokeColor=#8C8C86;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="A4" target="A5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" value="成功" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;fontSize=10;labelBackgroundColor=#FCFCFA;fontColor=#4A4A45;strokeColor=#7E8F7A;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="A5" target="A6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="Anote" value="&lt;b&gt;适用&lt;/b&gt;&lt;br&gt;旅行、临时使用另一区服务、首次装错区。&lt;br&gt;&lt;br&gt;&lt;b&gt;不做&lt;/b&gt;&lt;br&gt;账号迁移、订阅转移、数据搬迁；目标区没有账号就走注册。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FBF9F4;strokeColor=#D2CABC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fontColor=#3A3A36;" vertex="1" parent="1"><mxGeometry x="480" y="215" width="420" height="190" as="geometry"/></mxCell>
        <mxCell id="Adiff" value="&lt;b&gt;A 与 B 的区别&lt;/b&gt;&lt;br&gt;A 只切 base URL：不调用账号服务、不检查订阅、&lt;br&gt;不创建目标区账号、不触发赠礼或权益迁移。&lt;br&gt;如果目标区没有账号，用户在那里走正常注册。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FBF9F4;strokeColor=#D2CABC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fontColor=#3A3A36;" vertex="1" parent="1"><mxGeometry x="100" y="725" width="800" height="110" as="geometry"/></mxCell>
        <mxCell id="B1" value="设置 → 账号与区域&lt;br&gt;→ 切换区域" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.2;fontColor=#3A3A36;fillColor=#F4F1EB;strokeColor=#B8AE9E;" vertex="1" parent="1"><mxGeometry x="1020" y="215" width="320" height="58" as="geometry"/></mxCell>
        <mxCell id="B2" value="服务端检查阻断项" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.2;fontColor=#3A3A36;fillColor=#F1F2EF;strokeColor=#9CA69B;" vertex="1" parent="1"><mxGeometry x="1020" y="300" width="320" height="58" as="geometry"/></mxCell>
        <mxCell id="D1" value="存在阻断项？" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FAF7EF;strokeColor=#C3B69C;strokeWidth=1.2;fontColor=#4A453D;" vertex="1" parent="1"><mxGeometry x="1070" y="385" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="B3" value="说明原因与影响&lt;br&gt;（订阅 / 订单 / 余额 / 任务）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.2;fontColor=#3A3A36;fillColor=#F7F7F5;strokeColor=#A8A8A2;" vertex="1" parent="1"><mxGeometry x="1020" y="495" width="320" height="58" as="geometry"/></mxCell>
        <mxCell id="B4" value="选项：保留当前账号，&lt;br&gt;另建目标区账号 / 等订阅到期" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.2;fontColor=#3A3A36;fillColor=#F4F1EB;strokeColor=#B8AE9E;" vertex="1" parent="1"><mxGeometry x="1020" y="580" width="320" height="68" as="geometry"/></mxCell>
        <mxCell id="B5" value="阻断：本次不换区" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.2;fontColor=#3A3A36;fillColor=#F5EDEA;strokeColor=#B49A92;fontColor=#5B403A;" vertex="1" parent="1"><mxGeometry x="1020" y="675" width="320" height="58" as="geometry"/></mxCell>
        <mxCell id="B6" value="重新认证：密码 / OTP" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.2;fontColor=#3A3A36;fillColor=#F4F1EB;strokeColor=#B8AE9E;" vertex="1" parent="1"><mxGeometry x="1420" y="385" width="320" height="58" as="geometry"/></mxCell>
        <mxCell id="B7" value="目标区创建 / 绑定独立账号&lt;br&gt;同手机 / 邮箱允许（区域唯一）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.2;fontColor=#3A3A36;fillColor=#F1F2EF;strokeColor=#9CA69B;" vertex="1" parent="1"><mxGeometry x="1420" y="470" width="320" height="68" as="geometry"/></mxCell>
        <mxCell id="B8" value="签发新 token、切 base URL&lt;br&gt;清旧会话" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.2;fontColor=#3A3A36;fillColor=#F7F7F5;strokeColor=#A8A8A2;" vertex="1" parent="1"><mxGeometry x="1420" y="565" width="320" height="58" as="geometry"/></mxCell>
        <mxCell id="B9" value="已切换到目标区&lt;br&gt;原区账号保留，可随时切回" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.2;fontColor=#3A3A36;fillColor=#EDF1EB;strokeColor=#8E9C88;fontStyle=1;fontColor=#3E4A3B;" vertex="1" parent="1"><mxGeometry x="1420" y="650" width="320" height="68" as="geometry"/></mxCell>
        <mxCell id="Bnote" value="冷却期 + 审计日志；&lt;br&gt;两区权益不合并、不互转。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FBF9F4;strokeColor=#D2CABC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fontColor=#3A3A36;" vertex="1" parent="1"><mxGeometry x="1420" y="740" width="320" height="58" as="geometry"/></mxCell>
        <mxCell id="b1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;fontSize=10;labelBackgroundColor=#FCFCFA;fontColor=#4A4A45;strokeColor=#8C8C86;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="B1" target="B2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;fontSize=10;labelBackgroundColor=#FCFCFA;fontColor=#4A4A45;strokeColor=#8C8C86;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="B2" target="D1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b3" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;fontSize=10;labelBackgroundColor=#FCFCFA;fontColor=#4A4A45;strokeColor=#B08F65;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="D1" target="B3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;fontSize=10;labelBackgroundColor=#FCFCFA;fontColor=#4A4A45;strokeColor=#8C8C86;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="B3" target="B4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b5" value="选择等待" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;fontSize=10;labelBackgroundColor=#FCFCFA;fontColor=#4A4A45;strokeColor=#A87F76;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="B4" target="B5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b5b" value="选择另建" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;fontSize=10;labelBackgroundColor=#FCFCFA;fontColor=#4A4A45;strokeColor=#7E8F7A;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="B4" target="B6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b6" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;fontSize=10;labelBackgroundColor=#FCFCFA;fontColor=#4A4A45;strokeColor=#7E8F7A;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="D1" target="B6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;fontSize=10;labelBackgroundColor=#FCFCFA;fontColor=#4A4A45;strokeColor=#8C8C86;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="B6" target="B7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;fontSize=10;labelBackgroundColor=#FCFCFA;fontColor=#4A4A45;strokeColor=#8C8C86;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="B7" target="B8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;fontSize=10;labelBackgroundColor=#FCFCFA;fontColor=#4A4A45;strokeColor=#8C8C86;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="B8" target="B9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="travel" value="&lt;b&gt;旅行场景（必须单独处理）&lt;/b&gt;&lt;br&gt;IP 变了但账号区域不变：登录时账号区域优先，提示“你的账号属于中国版，继续连接中国版？”，&lt;b&gt;不自动换区&lt;/b&gt;。只有在用户主动进入“切换区域”并完成重新认证后，才创建目标区账号。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FBF9F4;strokeColor=#D2CABC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fontColor=#3A3A36;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="1920" height="62" as="geometry"/></mxCell>
        <mxCell id="rules" value="&lt;b&gt;换区阻断项（默认策略）&lt;/b&gt;&lt;table border='1' cellspacing='0' cellpadding='4' style='border-collapse:collapse;font-size:10px;width:100%;border-color:#D8D2C7;'&gt;&lt;tr style='background:#F1EEE8'&gt;&lt;th align='left'&gt;资产 / 状态&lt;/th&gt;&lt;th align='left'&gt;换区时处理&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;生效中的订阅&lt;/td&gt;&lt;td&gt;默认阻断，等订阅到期后再换；避免剩余权益纠纷&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;待支付 / 退款中订单&lt;/td&gt;&lt;td&gt;阻断，先完成或取消&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;钱包余额 / AI 积分&lt;/td&gt;&lt;td&gt;不跨区转移；换区前明确提示&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;运行中的任务&lt;/td&gt;&lt;td&gt;阻断，完成 / 取消 / 导出后再换&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;团队所有权 / 多席位&lt;/td&gt;&lt;td&gt;转人工，不做自助换区&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;用户数据 / 文件&lt;/td&gt;&lt;td&gt;按区域合规保留，不做跨境搬迁&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FBF9F4;strokeColor=#D2CABC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fontColor=#3A3A36;" vertex="1" parent="1"><mxGeometry x="40" y="968" width="900" height="240" as="geometry"/></mxCell>
        <mxCell id="after" value="&lt;b&gt;换区后的用户告知&lt;/b&gt;&lt;br&gt;• 原区账号仍保留，可随时切回&lt;br&gt;• 订阅、订单、钱包、AI 余额不随账号迁移&lt;br&gt;• 目标区需要重新登录 / 注册&lt;br&gt;• 客服工单按区域分流&lt;br&gt;&lt;br&gt;&lt;b&gt;验收口径&lt;/b&gt;&lt;br&gt;• 有生效订阅时 100% 阻断，并说明原因与到期日&lt;br&gt;• 无阻断时换区成功率达到 99% 以上&lt;br&gt;• 换区后旧 token 立即失效，旧区会话不可再用&lt;br&gt;• 同一手机 / 邮箱允许两区各有一个独立账号" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FBF9F4;strokeColor=#D2CABC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fontColor=#3A3A36;" vertex="1" parent="1"><mxGeometry x="980" y="968" width="980" height="240" as="geometry"/></mxCell>
        <mxCell id="footer" value="依据：2026-10-20 账号打通方案讨论；目标态。当前桌面端没有区域概念，以上流程需要服务端区域路由与客户端 base URL 切换能力。" style="text;html=1;fontSize=9;align=left;verticalAlign=middle;fontColor=#8C877D;" vertex="1" parent="1"><mxGeometry x="40" y="1228" width="1920" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
